<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login (example shell) — enable via portal.json</title>
  <!--
    CTA example stub — NOT live.
    To enable: copy to login.html, set ctas.items login.shell = "login.html",
    and point the redirect at your execution host login URL.
  -->
  <meta http-equiv="refresh" content="0;url=https://EXAMPLE.vercel.app/app/login.html">
  <script>location.replace('https://EXAMPLE.vercel.app/app/login.html');</script>
</head>
<body>
  <p><a href="https://EXAMPLE.vercel.app/app/login.html">Continue to Login</a> &middot; <a href="index.html">Marketing home</a></p>
</body>
</html>
