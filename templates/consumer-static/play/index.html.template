<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{PRODUCT_NAME}} - Play</title>
  <link rel="stylesheet" href="{{GLOSS_THEME_CSS_URL}}" integrity="{{GLOSS_THEME_CSS_SRI}}" crossorigin="anonymous">
  <link rel="stylesheet" href="{{MERIT_UX_CSS_URL}}" integrity="{{MERIT_UX_CSS_SRI}}" crossorigin="anonymous">
  <style id="play-make-art">
    /* Layout tokens - colors from GlossPack. Make Art composition (TB/Apple editorial bar). */
    .ma-home {
      display: flex; flex-direction: column; gap: 0;
      max-width: 52rem; margin: 0 auto;
    }
    .ma-hero {
      min-height: min(70vh, 36rem);
      display: flex; flex-direction: column; justify-content: center;
      gap: 1rem; padding: 2.5rem 0 3rem;
      background:
        radial-gradient(ellipse 80% 60% at 20% 0%, color-mix(in srgb, var(--merit-accent, #2a6f6a) 18%, transparent), transparent 55%),
        radial-gradient(ellipse 50% 40% at 100% 30%, color-mix(in srgb, var(--merit-accent, #2a6f6a) 10%, transparent), transparent 50%);
    }
    .ma-hero__brand {
      margin: 0; font-size: clamp(2.4rem, 7vw, 3.75rem);
      line-height: 1.05; font-weight: 500; letter-spacing: -0.03em;
    }
    .ma-hero__headline {
      margin: 0; font-size: clamp(1.2rem, 2.8vw, 1.55rem);
      font-weight: 500; opacity: 0.95; max-width: 28rem;
    }
    .ma-hero__lede {
      margin: 0; max-width: 32rem; line-height: 1.5; opacity: 0.88; font-size: 1.05rem;
    }
    .ma-cta-row { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 0.5rem; }
    .ma-cta {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 0.85rem 1.35rem; font-weight: 700; text-decoration: none;
      border-radius: 999px; border: 2px solid transparent;
      background: var(--merit-accent, #2a6f6a); color: var(--merit-on-accent, #fff);
    }
    .ma-cta--ghost {
      background: transparent; color: var(--merit-accent, #2a6f6a);
      border-color: var(--merit-accent, #2a6f6a);
    }
    .ma-section { padding: 2.5rem 0 1rem; }
    .ma-section h2 {
      margin: 0 0 1rem; font-size: 1.65rem; font-weight: 500; letter-spacing: -0.02em;
    }
    .ma-paths {
      display: grid; gap: 1.25rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 48rem) {
      .ma-paths { grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
    }
    .ma-path { display: flex; flex-direction: column; gap: 0.35rem; }
    .ma-path h3 { margin: 0; font-size: 1.15rem; font-weight: 600; }
    .ma-path p { margin: 0; line-height: 1.45; opacity: 0.88; font-size: 0.98rem; }
    .ma-path a {
      margin-top: 0.25rem; font-weight: 600; color: var(--merit-accent, #2a6f6a);
      text-decoration: none; width: fit-content;
    }
    .ma-path a:hover { text-decoration: underline; }
    .ma-table-wrap { overflow-x: auto; margin-top: 0.5rem; }
    .ma-table {
      width: 100%; border-collapse: collapse; font-size: 0.95rem;
    }
    .ma-table th, .ma-table td {
      text-align: left; padding: 0.7rem 0.55rem;
      border-bottom: 1px solid color-mix(in srgb, var(--merit-fg, #222) 14%, transparent);
      vertical-align: top;
    }
    .ma-table th { font-weight: 700; opacity: 0.95; }
    .ma-table td { opacity: 0.9; }
    .ma-tag {
      display: inline-block; font-size: 0.72rem; font-weight: 700;
      padding: 0.15rem 0.5rem; border-radius: 999px;
      background: color-mix(in srgb, var(--merit-accent, #2a6f6a) 16%, transparent);
      color: var(--merit-accent, #2a6f6a);
    }
    details.geek { margin: 2.75rem 0 1rem; }
    details.geek > summary { cursor: pointer; font-weight: 600; }
    .ma-geek-list { margin: 0.75rem 0 0; padding-left: 1.15rem; line-height: 1.55; }
    .ma-geek-list a { color: var(--merit-accent, #2a6f6a); }
  </style>
</head>
<body>
  <script src="{{MERIT_UX_JS_URL}}" integrity="{{MERIT_UX_JS_SRI}}" crossorigin="anonymous"></script>
  <script>
    (function () {
      var PRODUCT = {{PRODUCT_NAME_JS}};
      var CONSUMER_ID = {{CONSUMER_ID_JS}};
      var REGISTER_URL = {{REGISTER_URL_JS}};
      var GLOSS_THEME = {{GLOSS_THEME_JS}};
      var COMMUNITY_RAILS_URL = {{COMMUNITY_RAILS_URL_JS}};
      var GW = 'https://merit-prod.vercel.app';

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function registerPlan(plan) {
        var base = String(REGISTER_URL || '');
        if (!plan) return base;
        return base + (base.indexOf('?') >= 0 ? '&' : '?') + 'plan=' + encodeURIComponent(plan);
      }

      /* Clean default catalog — keep in sync with cfg/store_catalog.json (FR-MPD-40) */
      var PLANS = [
        {
          name: 'Community Member',
          promise: 'Join your community and post when eligible.',
          price: 'Free',
          plan: 'community-member',
          tag: 'Start'
        },
        {
          name: 'Office Hours',
          promise: 'Sit with the host — chat and/or video when hours are live.',
          price: 'Free',
          plan: 'oh-attend',
          tag: 'Meet'
        },
        {
          name: 'Consult 20 minutes',
          promise: 'Book a collaboration slot when the calendar opens.',
          price: 'Free',
          plan: 'consult-20m',
          tag: 'Book'
        },
        {
          name: 'Plus',
          promise: 'Room to grow — open caps on journal, AMA, and member seats.',
          price: '$10.79 / mo',
          plan: 'plus-monthly',
          tag: 'Grow'
        }
      ];

      function plansTableHtml() {
        var rows = PLANS.map(function (p) {
          return (
            '<tr>' +
              '<td><strong>' + esc(p.name) + '</strong><br><span class="ma-tag">' + esc(p.tag) + '</span></td>' +
              '<td>' + esc(p.promise) + '</td>' +
              '<td>' + esc(p.price) + '</td>' +
              '<td><a href="' + esc(registerPlan(p.plan)) + '">Choose</a></td>' +
            '</tr>'
          );
        }).join('');
        return (
          '<div class="ma-table-wrap"><table class="ma-table">' +
            '<thead><tr><th>Plan</th><th>What you get</th><th>Price</th><th></th></tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
          '</table></div>'
        );
      }

      function homeHtml() {
        return (
          '<div class="ma-home">' +
            '<section class="ma-hero" aria-label="Welcome">' +
              '<h1 class="ma-hero__brand">' + esc(PRODUCT) + '</h1>' +
              '<p class="ma-hero__headline">Ask, meet, book, and journal - together.</p>' +
              '<p class="ma-hero__lede">Your community is live. Register free to join channels, office hours, consults, and a private journal. Grow into Plus when you need more room.</p>' +
              '<div class="ma-cta-row">' +
                '<a class="ma-cta" href="' + esc(registerPlan('community-member')) + '">Register free</a>' +
                '<a class="ma-cta ma-cta--ghost" href="#plans">See plans</a>' +
              '</div>' +
            '</section>' +

            '<section class="ma-section" aria-label="What you can do">' +
              '<h2>How it comes together</h2>' +
              '<div class="ma-paths">' +
                pathHtml('Ask', 'Bring questions to the community AMA - free for eligible members.', registerPlan('community-member'), 'Join free to ask') +
                pathHtml('Meet', 'Weekly office hours on chat and video when the host is live.', registerPlan('oh-attend'), 'Save a seat') +
                pathHtml('Book', 'Twenty-minute consult slots with calm booking.', registerPlan('consult-20m'), 'Book a slot') +
                pathHtml('Journal', 'Private notes with share modes when you are ready.', registerPlan('community-member'), 'Start free') +
              '</div>' +
            '</section>' +

            '<section class="ma-section" id="plans" aria-label="Plans">' +
              '<h2>Plans</h2>' +
              '<p class="ma-hero__lede" style="margin-bottom:0.75rem">Clean access for every default capability. Plus opens freemium caps.</p>' +
              plansTableHtml() +
            '</section>' +

            '<details class="geek">' +
              '<summary>Advanced: builder next steps</summary>' +
              '<ul class="ma-geek-list">' +
                '<li>Your live app: <code>/apps/' + esc(CONSUMER_ID) + '/play</code> on merit-prod</li>' +
                '<li>Register for this app: <a href="' + esc(REGISTER_URL) + '">' + esc(REGISTER_URL) + '</a></li>' +
                '<li><a href="' + esc(GW + '/portal/developers/full-app/') + '" target="_blank" rel="noopener noreferrer">Your app over dinner</a> — PRD, portal, then <code>app_logic/</code></li>' +
                '<li><a href="' + esc(GW + '/portal/developers/sku-commerce/') + '" target="_blank" rel="noopener noreferrer">Sell SKUs and subscriptions</a></li>' +
                '<li><a href="' + esc(GW + '/portal/developers/par-packages/') + '" target="_blank" rel="noopener noreferrer">UI packages on the gateway</a></li>' +
                '<li><a href="' + esc(COMMUNITY_RAILS_URL) + '" target="_blank" rel="noopener noreferrer">Platform live-check evidence</a> (operator probes — not product screenshots)</li>' +
                '<li>Optional platform builder join: <a href="' + esc(GW + '/store/merit/register?plan=app-builder') + '" target="_blank" rel="noopener noreferrer">/store/merit/register?plan=app-builder</a></li>' +
                '<li><a href="' + esc(GW + '/portal/developers/troubleshooting/#start-over') + '" target="_blank" rel="noopener noreferrer">Start over — leave platform and create again</a></li>' +
              '</ul>' +
            '</details>' +
          '</div>'
        );
      }

      function pathHtml(title, blurb, href, cta) {
        return (
          '<article class="ma-path">' +
            '<h3>' + esc(title) + '</h3>' +
            '<p>' + esc(blurb) + '</p>' +
            '<a href="' + esc(href) + '">' + esc(cta) + '</a>' +
          '</article>'
        );
      }

      function bootGlossShell() {
        var ux = window.MeritUx;
        if (!ux || typeof ux.createAppShell !== 'function') {
          document.body.innerHTML = homeHtml();
          return null;
        }
        var shell = ux.createAppShell({
          host: document.body,
          theme: GLOSS_THEME,
          brand: {
            name: PRODUCT,
            tagline: '',
            eyebrow: 'Powered by MERIT'
          },
          freemium: {
            tierLabel: 'Free',
            upgradeHref: REGISTER_URL,
            upgradeLabel: 'Register'
          },
          legal: {
            brandName: PRODUCT,
            disclaimer: 'MERIT Powered - your product home on platform rails.'
          },
          slots: { main: '#app-logic' },
          peers: { workbench: false, journal: false }
        });
        if (shell && shell.main) {
          shell.main.innerHTML = homeHtml();
        }
        if (shell && shell.status && typeof ux.setStatusState === 'function') {
          ux.setStatusState(shell.status, 'ok');
        }
        return shell;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootGlossShell);
      } else {
        bootGlossShell();
      }
    })();
  </script>
  {{JOURNAL_TAGS}}
</body>
</html>
