<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{PRODUCT_NAME}} — Play</title>
  <link rel="stylesheet" href="{{GLOSS_THEME_CSS_URL}}" integrity="{{GLOSS_THEME_CSS_SRI}}" crossorigin="anonymous">
  <link rel="stylesheet" href="{{MERIT_UX_CSS_URL}}" integrity="{{MERIT_UX_CSS_SRI}}" crossorigin="anonymous">
  <link rel="stylesheet" href="{{WORKBENCH_CSS_URL}}" integrity="{{WORKBENCH_CSS_SRI}}" crossorigin="anonymous">
  <style id="play-value-tour">
    /* Layout tokens only — colors/type from GlossPack */
    .value-tour { display: flex; flex-direction: column; gap: 2rem; }
    .value-tour__hero { display: flex; flex-direction: column; gap: 0.75rem; max-width: 36rem; }
    .value-tour__hero h1 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; }
    .value-tour__hero p { margin: 0; opacity: 0.9; line-height: 1.45; }
    .value-tour__cta {
      display: inline-flex; align-items: center; justify-content: center;
      width: fit-content; margin-top: 0.35rem; padding: 0.65rem 1.15rem;
      font-weight: 600; text-decoration: none; border-radius: 0.4rem;
      background: var(--merit-accent, #2a6f6a); color: var(--merit-on-accent, #fff);
    }
    .value-tour__grid {
      display: grid; gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
    .value-tour__card { display: flex; flex-direction: column; gap: 0.5rem; }
    .value-tour__card h2 { margin: 0; font-size: 1.1rem; }
    .value-tour__card p { margin: 0; font-size: 0.95rem; line-height: 1.4; opacity: 0.88; }
    .value-tour__thumb {
      display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover;
      border-radius: 0.35rem; background: color-mix(in srgb, var(--merit-fg, #222) 8%, transparent);
    }
    .value-tour__proof { font-size: 0.85rem; }
    details.geek { margin-top: 2.5rem; }
    details.geek > summary { cursor: pointer; font-weight: 600; }
    #merit-workbench-mount { margin-top: 1rem; min-height: 12rem; }
  </style>
</head>
<body>
  <main id="app-logic">
    <section class="value-tour" aria-label="Value tour">
      <div class="value-tour__hero">
        <h1>Welcome to {{PRODUCT_NAME}}</h1>
        <p>Ask the community, meet for office hours, book a consult, and keep a private journal — on MERIT rails.</p>
        <a class="value-tour__cta" href="{{REGISTER_URL}}">Register free</a>
      </div>
      <div class="value-tour__grid">
        <article class="value-tour__card" data-tour="ask">
          <h2>Ask</h2>
          <p>AMA questions on the community channel — free for eligible members.</p>
          <a class="value-tour__proof" href="{{COMMUNITY_RAILS_URL}}" target="_blank" rel="noopener noreferrer">
            <img class="value-tour__thumb" src="{{EVIDENCE_BASE_URL}}/02-member.png" alt="Ask — community member proof" width="640" height="400" loading="lazy">
          </a>
        </article>
        <article class="value-tour__card" data-tour="meet">
          <h2>Meet</h2>
          <p>Office Hours on chat and/or video — scheduled from your collab cfg.</p>
          <a class="value-tour__proof" href="{{COMMUNITY_RAILS_URL}}" target="_blank" rel="noopener noreferrer">
            <img class="value-tour__thumb" src="{{EVIDENCE_BASE_URL}}/00-overview.png" alt="Meet — community overview proof" width="640" height="400" loading="lazy">
          </a>
        </article>
        <article class="value-tour__card" data-tour="book">
          <h2>Book</h2>
          <p>Collaboration Corner consult slots with conflict-before-book calendar.</p>
          <a class="value-tour__proof" href="{{COMMUNITY_RAILS_URL}}" target="_blank" rel="noopener noreferrer">
            <img class="value-tour__thumb" src="{{EVIDENCE_BASE_URL}}/04-consult.png" alt="Book — consult proof" width="640" height="400" loading="lazy">
          </a>
        </article>
        <article class="value-tour__card" data-tour="journal">
          <h2>Journal</h2>
          <p>Private notes with share modes and deadline alerts when you are ready.</p>
          <a class="value-tour__proof" href="{{COMMUNITY_RAILS_URL}}" target="_blank" rel="noopener noreferrer">
            <img class="value-tour__thumb" src="{{EVIDENCE_BASE_URL}}/01-guest.png" alt="Journal — guest surface proof" width="640" height="400" loading="lazy">
          </a>
        </article>
      </div>
    </section>

    <details class="geek">
      <summary>Advanced: builder rails</summary>
      <div id="merit-workbench-mount"></div>
    </details>
  </main>

  <script src="{{MERIT_UX_JS_URL}}" integrity="{{MERIT_UX_JS_SRI}}" crossorigin="anonymous"></script>
  <script src="{{WORKBENCH_JS_URL}}" integrity="{{WORKBENCH_JS_SRI}}" crossorigin="anonymous"></script>
  <script>
    (function () {
      var PRODUCT = {{PRODUCT_NAME_JS}};
      var CONSUMER_ID = {{CONSUMER_ID_JS}};
      var REGISTER_URL = {{REGISTER_URL_JS}};
      var GLOSS_THEME = {{GLOSS_THEME_JS}};
      var GW = 'https://merit-prod.vercel.app';

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function linkHtml(href, label) {
        return '<a href="' + esc(href) + '" target="_blank" rel="noopener noreferrer">' + esc(label) + '</a>';
      }

      function bootGlossShell() {
        var ux = window.MeritUx;
        if (!ux || typeof ux.createAppShell !== 'function') return null;
        var shell = ux.createAppShell({
          host: document.body,
          theme: GLOSS_THEME,
          brand: {
            name: PRODUCT,
            tagline: 'Ask · Meet · Book · Journal',
            eyebrow: 'Powered by MERIT'
          },
          freemium: {
            tierLabel: 'Free',
            upgradeHref: REGISTER_URL,
            upgradeLabel: 'Register'
          },
          legal: {
            brandName: PRODUCT,
            disclaimer: 'MERIT Powered — platform rails, not a second marketing portal.'
          },
          slots: { main: '#app-logic' },
          peers: { workbench: true, journal: true }
        });
        if (shell && shell.status && typeof ux.setStatusState === 'function') {
          ux.setStatusState(shell.status, 'ok');
        }
        return shell;
      }

      function bootMeritWorkbench() {
        var mw = window.merit_workbench;
        var host = document.getElementById('merit-workbench-mount');
        if (!mw || !host || typeof mw.mountMeritWorkbenchPanel !== 'function') return;
        if (host.childElementCount) return;

        var rows = [
          {
            id: 'auth',
            hnd: 'Auth / login',
            handle: 'meritsubs',
            preview: 'Open guide',
            levels: 'Rails ready',
            detail:
              '<p>Subscriber identity for <strong>' + esc(PRODUCT) + '</strong> runs on MERIT rails (signup, session, Free/Plus).</p>' +
              '<p>' + linkHtml(GW + '/portal/developers/auth-subs/', 'Auth and subscriptions guide') + '</p>' +
              '<p>Wire login UX in <code>app_logic/</code> after dinner Steps 3–4 — do not fork auth into your repo.</p>'
          },
          {
            id: 'store',
            hnd: 'Store + default SKUs',
            handle: 'meritstore',
            preview: 'Register path',
            levels: 'Cfg scaffolded',
            detail:
              '<p>Free/Plus SKU files are in <code>cfg/</code> for your app. Checkout uses your register path:</p>' +
              '<p>' + linkHtml(REGISTER_URL, REGISTER_URL) + '</p>' +
              '<p>' + linkHtml(GW + '/portal/developers/sku-commerce/', 'SKU commerce guide') +
              ' — sell SKUs and subscriptions on platform rails.</p>'
          },
          {
            id: 'subs',
            hnd: 'meritsubs entitlements',
            handle: 'meritsubs',
            preview: 'Providers',
            levels: 'Gateway',
            detail:
              '<p>Tiers, entitlements, and usage meter through <code>/api/meritsubs/*</code> for consumer_id=<code>' +
              esc(CONSUMER_ID) + '</code>.</p>' +
              '<p>' + linkHtml(GW + '/portal/developers/providers/', 'Provider rails guide') + '</p>'
          },
          {
            id: 'utils',
            hnd: 'meritutils packages',
            handle: 'PAR CDN',
            preview: 'Registry',
            levels: 'Pinned',
            detail:
              '<p>Packages available through the gateway CDN for your play / app_logic:</p>' +
              '<ul>' +
              '<li><strong>merit_ux</strong> — DualRail Gloss shell (this page)</li>' +
              '<li><strong>merit_workbench</strong> — Advanced builder grid / inspector</li>' +
              '<li><strong>journal</strong> — compose + history on the workbench</li>' +
              '<li><strong>merit_ama</strong> — Q and A primitives</li>' +
              '<li><strong>merit_calendar</strong> — consult scheduling</li>' +
              '<li><strong>merit_video</strong> — room-media / Zoom</li>' +
              '</ul>' +
              '<p>' + linkHtml(GW + '/pkg/meritutils/registry.json', 'meritutils registry.json') +
              ' · ' + linkHtml(GW + '/portal/developers/par-packages/', 'PAR packages guide') + '</p>'
          },
          {
            id: 'community',
            hnd: 'Community channels',
            handle: 'cfg/community.json',
            preview: 'Scaffolded',
            levels: 'Baseline',
            detail:
              '<p>Default channels (<code>general</code>, <code>ama</code>, <code>announcements</code>) live in <code>cfg/community.json</code>.</p>' +
              '<p>Eligible registered members can post; guests browse marketing only. Email hooks use platform <code>merit_notify</code>.</p>'
          },
          {
            id: 'ama',
            hnd: 'AMA + Office Hours',
            handle: 'merit_ama',
            preview: 'Cfg ready',
            levels: 'Baseline',
            detail:
              '<p>AMA questions log on channel <code>ama</code>. Office Hours default Mondays 5–6pm Pacific (chat and/or Zoom) from <code>cfg/collab_schedule.json</code>.</p>' +
              '<p>Free for eligible Community Member tiers. Wire UI via meritutils AMA / video packages.</p>'
          },
          {
            id: 'collab',
            hnd: 'Collaboration Corner',
            handle: 'merit_calendar',
            preview: 'Cfg ready',
            levels: 'Baseline',
            detail:
              '<p>Consult grid Tue/Thu 4–8pm Pacific, 20-minute slots. Shared free/busy + conflict-before-book via <code>merit_calendar</code> (EventCalendar + rrule).</p>' +
              '<p>Schedule + $0 SKUs: <code>cfg/collab_schedule.json</code>. Zoom meetings via <code>merit_video</code> / platform room-media.</p>'
          },
          {
            id: 'journal-alerts',
            hnd: 'Journal + alerts',
            handle: 'journal / alerts',
            preview: 'Cfg ready',
            levels: 'Baseline',
            detail:
              '<p>Private journal with share modes; todos with deadlines. Alert offsets in <code>cfg/alerts.json</code> (VAPID + email).</p>' +
              '<p>Workbench already mounts journal when pinned — extend share/todo in app_logic as packages land.</p>'
          },
          {
            id: 'applogic',
            hnd: 'Next: app_logic/',
            handle: 'Dinner 3–4',
            preview: 'Full-app guide',
            levels: 'Your turn',
            detail:
              '<p>Value Tour is Step 2 taste. Product features land in <code>app_logic/</code> for <strong>' +
              esc(PRODUCT) + '</strong>:</p>' +
              '<ol>' +
              '<li><code>/merit-prd</code> — fill <code>docs/PRODUCT.prd.md</code></li>' +
              '<li><code>/merit-portal</code> — shape marketing <code>portal/</code>, then republish</li>' +
              '<li><code>/merit-applogic</code> — implement Must FRs under <code>app_logic/</code></li>' +
              '</ol>' +
              '<p>' + linkHtml(GW + '/portal/developers/full-app/', 'Your app over dinner') + '</p>'
          }
        ];

        mw.mountMeritWorkbenchPanel(host, {
          title: PRODUCT,
          gridTitle: 'Your MERIT rails',
          theme: 'merit-dark',
          idKey: 'id',
          features: { downstream: false },
          columns: [
            { id: 'hnd', label: 'Capability' },
            { id: 'handle', label: 'Rail' },
            { id: 'preview', label: 'Open' },
            { id: 'levels', label: 'Status' }
          ],
          rows: rows,
          summary: {
            cards: [
              { label: 'Product', value: PRODUCT },
              { label: 'Step', value: '2 — DualRail Gloss' },
              { label: 'Next', value: 'app_logic/' },
              { label: 'Host', value: 'merit-prod' }
            ]
          },
          renderInspector: function (row) {
            return {
              title: row.hnd || 'Capability',
              bodyHtml: row.detail || '<p>Select a capability row.</p>'
            };
          }
        });
      }

      function bootMeritPlay() {
        bootGlossShell();
        bootMeritWorkbench();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootMeritPlay);
      } else {
        bootMeritPlay();
      }
    })();
  </script>
  {{JOURNAL_TAGS}}
</body>
</html>
